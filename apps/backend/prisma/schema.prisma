generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  name      String
  email     String   @unique
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senders   Sender[]
  campaigns Campaign[]
}

model Sender {
  id        String   @id @default(uuid())
  userId    String
  email     String
  name      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  emails    ScheduledEmail[]

  @@unique([userId, email])
  @@index([userId])
}

model Campaign {
  id            String         @id @default(uuid())
  userId        String
  senderId      String

  subject       String
  body          String

  startTime     DateTime
  delayMs       Int
  hourlyLimit   Int

  status        CampaignStatus @default(DRAFT)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender        Sender         @relation(fields: [senderId], references: [id], onDelete: Restrict)

  emails        ScheduledEmail[]

  @@index([userId])
  @@index([senderId])
  @@index([status])
}

model ScheduledEmail {
  id             String      @id @default(uuid())

  campaignId     String
  senderId       String

  recipient      String
  subject        String
  body           String

  scheduledAt    DateTime
  sentAt         DateTime?

  status         EmailStatus @default(SCHEDULED)

  attempts       Int         @default(0)
  lastError      String?

  bullJobId      String?     @unique
  messageId      String?
  previewUrl     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  campaign       Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender         Sender      @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([senderId])
  @@index([status])
  @@index([scheduledAt])
  @@unique([campaignId, recipient])
}